# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (rebuild with `npm run db:generate`)
/generated

# Test photos for local ID card checks. Real photos live in Contabo storage.
test-data/

# Local screenshot / PDF output from layout checks.
.shots/

# Compiled chat server and queue worker (npm run server:build)
server.mjs
worker.mjs

# Full-resolution photo originals; the site serves the optimized copies in web/.
public/eavi-assets/originals/
