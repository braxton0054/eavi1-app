generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  CAMPUS_ADMIN
  TUTOR
  STUDENT
}

enum Status {
  ACTIVE
  PENDING
  DISABLED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDECLARED
}

/// The grade an applicant holds on the Kenya Certificate of Secondary Education scale.
/// Named for admissions — the exam marks record is a separate model.
enum EntryGrade {
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D_PLUS
  D
  D_MINUS
  E
}

/// Where a period is in its life cycle. A period is PLANNED until it opens, ACTIVE while it
/// is running, and COMPLETED once it has ended and its results are settled.
enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum CalendarEventType {
  ACADEMIC
  HOLIDAY
  EXAMINATION
  ADMISSION
  FINANCE
  MEETING
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ExamType {
  CAT
  END_TERM
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  RELEASED
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CREDIT
  VOID
}

/// How a programme is delivered. Units are grouped by whichever of these it uses, so a
/// monthly course is not forced into semesters.
enum ProgramStructure {
  SEMESTER
  MONTHLY
  MODULE
  CUSTOM
}

/// Where a student stands on one unit. `COMPLETED` is the only state that counts towards
/// finishing a stage; progression past a stage is an administrator's decision, never a
/// side effect of a date passing.
enum UnitStatus {
  NOT_STARTED
  REGISTERED
  IN_PROGRESS
  COMPLETED
  FAILED
  DEFERRED
}

/// The three admission windows EAVI runs each year. Admissions happen every month, but
/// What a class record is allowed to represent. A regular class is the default; the other
/// two exist so offices do not have to invent ad-hoc programmes to hold unusual groups.
/// Merging is only ever done between classes of the same programme and campus.
enum ClassStatus {
  ACTIVE
  ARCHIVED
}

/// The attachment lifecycle, from "not yet due" to an outcome.
enum AttachmentStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  ATTACHED
  IN_PROGRESS
  COMPLETED
  FAILED
  DEFERRED
}

/// How a programme's fee is split into payable periods. The cadence row carries the kind so
/// the period rows can be generated from the duration instead of being typed one by one.
/// Terms are not here on purpose: this college runs semesters, and a term is a semester.
enum FeePeriodKind {
  MONTHLY
  SEMESTER
  ACADEMIC_YEAR
  ONE_TIME
  CUSTOM
}

enum PaymentMethod {
  MPESA
  CASH
  BANK
  CHEQUE
}

enum ReceiptStatus {
  ISSUED
  REVERSED
  REFUNDED
}

enum ReceiptKind {
  RECEIPT
  CREDIT_NOTE
}

enum PaymentEntryType {
  PAYMENT
  REVERSAL
  REFUND
}

enum InvoiceLineKind {
  CHARGE
  CREDIT_NOTE
  VOID
  VOID_REVERSAL
}

enum CardStatus {
  PENDING
  PRINTING
  ISSUED
  LOST
  REPLACED
}

enum Audience {
  EVERYONE
  STUDENTS
  TUTORS
}

/// The queue's lifecycle for a card print run: requested, rendered and stored, or given up on.
enum CardBatchStatus {
  PENDING
  COMPLETE
  FAILED
}

model Campus {
  id               Int              @id @default(autoincrement())
  code             String           @unique
  name             String
  place            String
  phone            String?
  /// An office such as the Town Office handles paperwork but teaches no course, so it is
  /// never handed an applicant. Only the campuses that teach take students.
  takesApplicants  Boolean          @default(true)
  users            User[]
  programs         Program[]        @relation("ProgramCampuses")
  students         StudentProfile[]
  tutors           TutorProfile[]
  applications     Application[]
  enrollments      Enrollment[]
  calendarEvents   CalendarEvent[]
  periods          AcademicPeriod[]
  timetableSlots   TimetableSlot[]
  exams            Exam[]
  invoices         Invoice[]
  receipts         Receipt[]
  announcements    Announcement[]
  idCards          IdCard[]
  cardTemplates    CardTemplate[]
  reportingDates   ReportingDate[]
  classes          AcademicClass[]
  cardBatches      CardBatch[]
  offerLetters     OfferLetter[]
  tutorAssignments TutorProfile[]   @relation("TutorCampuses")

  @@map("campuses")
}

model User {
  id                  String                  @id @default(uuid())
  /// Stored lowercased so the unique index is effectively case-insensitive.
  email               String                  @unique
  fullName            String
  phone               String?
  /// The administrator's own picture, shown next to their name in the portal header.
  photoUrl            String?
  passwordHash        String
  role                Role                    @default(STUDENT)
  status              Status                  @default(ACTIVE)
  mustChangePassword  Boolean                 @default(false)
  /// Presence is opt-out: people can hide when they were last around.
  showLastSeen        Boolean                 @default(true)
  /// Chat notification preferences, per person rather than per device.
  hideMessageText     Boolean                 @default(false)
  chatSoundEnabled    Boolean                 @default(true)
  campus              Campus?                 @relation(fields: [campusId], references: [id])
  campusId            Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  /// Google (and, if ever needed, other providers) linked to this account. Kept in a table
  /// of its own rather than a `googleSub` column so a person can hold several identities,
  /// the provider name is data rather than a column name, and the unique key is
  /// (provider, providerAccountId) — which is exactly what the database must never allow twice.
  oauthAccounts       OAuthAccount[]
  student             StudentProfile?
  tutor               TutorProfile?
  announcements       Announcement[]          @relation("AnnouncementAuthor")
  decisions           Application[]           @relation("ApplicationDecider")
  conversationMembers ConversationMember[]
  messages            Message[]               @relation("MessageSender")
  receipts            MessageReceipt[]
  blocksIssued        UserBlock[]             @relation("BlockIssuer")
  blocksReceived      UserBlock[]             @relation("BlockTarget")
  reports             MessageReport[]         @relation("ReportAuthor")
  chatRestrictions    ChatRestriction[]       @relation("RestrictedUser")
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  notificationPref    NotificationPreference?

  @@index([role, status])
  @@index([campusId])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@map("sessions")
}

/// One external identity linked to an EAVI account.
///
/// `providerAccountId` is Google's `sub`, not the email: a Google address can be renamed,
/// but the subject id cannot, so the link survives that. The unique key is scoped by
/// provider so a second adapter (if one is ever added) cannot collide with a Google id.
/// Nothing here is a credential — there is no token column, because sign-in is the only
/// thing this app does with Google and it needs no durable access to the account.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google" today; a literal rather than an enum so adding a second one is not a migration.
  provider          String   @default("google")
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A teaching department. Created once and then reused by every programme that
/// belongs to it, so the catalogue groups by spelling rather than by typing.
model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("departments")
}

/// The body a programme is registered with and examined by: KNEC, CDAC, TVETA and
/// the rest. Its code is the first half of every generated programme code.
model ProgramBody {
  id        String    @id @default(uuid())
  name      String    @unique
  /// Short upper-case letters used in programme codes, e.g. KNEC.
  code      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("program_bodies")
}

/// The kind of programme: Certificate, Diploma, Degree and anything else the college
/// adds. Its code is the middle of every generated programme code.
model ProgramType {
  id        String    @id @default(uuid())
  name      String    @unique
  /// Short upper-case letters used in programme codes, e.g. DIP.
  code      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("program_types")
}

/// How often a programme's fees fall due. Registered in programme settings so the
/// list is not fixed by the code. `kind` decides how the payable periods are generated:
/// twelve monthly periods, one per calendar semester, a single payment, and so on.
model FeeCadence {
  id        String           @id @default(uuid())
  name      String           @unique
  kind      FeePeriodKind    @default(CUSTOM)
  programs  Program[]
  plans     ProgramFeePlan[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("fee_cadences")
}

/// A programme on the college catalogue, offered at one or more campuses.
/// Every programme belongs to exactly one accrediting body and one type, and its
/// code is generated from those two: KNEC-DIP-001.
model Program {
  id                     String                  @id @default(uuid())
  code                   String                  @unique
  /// Unique among live programmes: a duplicate name is the same programme entered twice,
  /// and the office must never bill a student on a row their fee plan is not attached to.
  name                   String                  @unique
  departmentId           String
  department             Department              @relation(fields: [departmentId], references: [id])
  bodyId                 String
  body                   ProgramBody             @relation(fields: [bodyId], references: [id])
  typeId                 String
  type                   ProgramType             @relation(fields: [typeId], references: [id])
  cadenceId              String
  cadence                FeeCadence              @relation(fields: [cadenceId], references: [id])
  durationMonths         Int
  /// Semesters, months or modules. Decides how the unit planner groups its rows.
  structure              ProgramStructure        @default(SEMESTER)
  /// Set when the programme stops taking new admissions; its history stays readable.
  archivedAt             DateTime?
  archivedReason         String?
  /// Lowest KCSE aggregate the college admits against; the same scale the
  /// application form records an applicant's grade on.
  minKcseGrade           EntryGrade
  description            String?
  curriculumUrl          String?
  feeStructureUrl        String?
  /// Requirements printed on page 3 of an offer letter, one per line. Free text so the office
  /// phrases them in their own words, the same way a class name is theirs to write.
  admissionRequirements  String?
  /// The bursary form attached to every offer letter. Null falls back to the college default,
  /// so a programme only stores its own when it differs.
  bursaryFormUrl         String?
  campuses               Campus[]                @relation("ProgramCampuses")
  tutors                 TutorProfile[]          @relation("ProgramTutors")
  enrollments            Enrollment[]
  applications           Application[]
  feeItems               FeeItem[]
  feePlans               ProgramFeePlan[]
  units                  ProgramUnit[]
  modules                ProgramModule[]
  attachmentRequirements AttachmentRequirement[]
  exams                  Exam[]
  timetableSlots         TimetableSlot[]
  idCards                IdCard[]
  classes                AcademicClass[]
  offerLetters           OfferLetter[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("programs")
}

/// Academic record attached to a User with role STUDENT. Admission numbers are issued
/// by the campus admin, not by the self-service registration form.
model StudentProfile {
  id                     String              @id @default(uuid())
  userId                 String              @unique
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNo            String              @unique
  campusId               Int
  campus                 Campus              @relation(fields: [campusId], references: [id])
  gender                 Gender?
  dateOfBirth            DateTime?
  nationalId             String?
  guardianName           String?
  guardianPhone          String?
  guardianEmail          String?
  address                String?
  applicationId          String?             @unique
  application            Application?        @relation(fields: [applicationId], references: [id])
  primarySchool          String?
  secondarySchool        String?
  primarySchoolDocUrl    String?
  secondarySchoolDocUrl  String?
  birthCertificateUrl    String?
  medicalInfo            String?
  hasNoMedicalConditions Boolean             @default(false)
  profilePhotoUrl        String?
  admissionCategory      String?
  previousInstitution    String?
  /// The day the student was actually admitted. Admissions run every month, so this can be
  /// February even though their intake is January — the two are deliberately separate.
  admissionDate          DateTime?
  parentGuardians        ParentGuardian[]
  emergencyContacts      EmergencyContact[]
  enrollments            Enrollment[]
  invoices               Invoice[]
  payments               Payment[]
  receipts               Receipt[]
  attachments            StudentAttachment[]
  idCards                IdCard[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([campusId])
  @@map("student_profiles")
}

/// Academic record attached to a User with role TUTOR.
model TutorProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffNo        String          @unique
  /// Classes this tutor is responsible for. Drives class group-chat membership.
  classes        ClassTutor[]
  campusId       Int
  campus         Campus          @relation(fields: [campusId], references: [id])
  /// A tutor may teach at more than one campus; a super admin picks them on the form.
  campuses       Campus[]        @relation("TutorCampuses")
  title          String?
  department     String?
  programs       Program[]       @relation("ProgramTutors")
  timetableSlots TimetableSlot[]
  invigilations  Exam[]          @relation("ExamInvigilator")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([campusId])
  @@map("tutor_profiles")
}

/// A prospect's application. It stays an application until enrolment turns it into a
/// student, which is a separate step; the reference is the number the applicant keeps.
model Application {
  id                        String            @id @default(uuid())
  reference                 String            @unique
  fullName                  String
  /// An applicant may leave this out; the office confirms one before admitting.
  email                     String?
  phone                     String
  gender                    Gender?
  grade                     EntryGrade?
  programId                 String
  program                   Program           @relation(fields: [programId], references: [id])
  campusId                  Int
  campus                    Campus            @relation(fields: [campusId], references: [id])
  status                    ApplicationStatus @default(SUBMITTED)
  previousQualification     String?
  notes                     String?
  decisionNote              String?
  decidedById               String?
  decidedBy                 User?             @relation("ApplicationDecider", fields: [decidedById], references: [id])
  decidedAt                 DateTime?
  /// Recorded by the office only after it has proven control of the phone or email.
  contactVerifiedAt         DateTime?
  contactVerificationMethod String?
  createdAt                 DateTime          @default(now())
  /// The offer letter issued from this application, if any.
  offerLetter               OfferLetter?
  studentProfile            StudentProfile?
  updatedAt                 DateTime          @updatedAt

  @@index([campusId, status])
  @@map("applications")
}

/// One intake and the teaching window that goes with it, shared by the whole college.
///
/// This replaces two separate tables — a `Semester` calendar and an `Intake` admission window —
/// which described the same thing and drifted apart in practice, leaving campuses with one
/// populated and the other empty. The college runs three intakes a year, and each one IS the
/// start of a period, so they are one row here.
///
/// A period is the INSTITUTIONAL CALENDAR: when the college is open for teaching and when
/// applications for that intake close. Every campus sees the same window. Classes, invoices,
/// exams and timetable slots still belong to a campus, but point at this shared row.
///
/// `campusId` is retained only as a nullable legacy column so existing references can be
/// repointed. New periods are always written with it null; a non-null value is an old row that
/// predates the shared calendar.
///
/// It is NOT the student's own semester number. A student's position in their programme lives
/// on `Enrollment.yearIndex` / `semesterNo`, derived from the period they joined and counted
/// forward from there, so a May joiner is in their own Semester 1 in May even though the
/// campus calendar has moved on.
model AcademicPeriod {
  id                  String               @id @default(uuid())
  /// Legacy campus link. Null means college-wide; the application never sets it.
  campusId            Int?
  campus              Campus?              @relation(fields: [campusId], references: [id])
  /// The calendar year the period opens in.
  year                Int
  /// The month the period opens: 1, 5 or 9 only. Those three are the college's intakes, and the
  /// database enforces it (see the CHECK constraint in the migration) so a December cohort
  /// cannot exist to confuse every picker downstream.
  month               Int
  /// Which of the year's three periods this is: 1 for January, 2 for May, 3 for September.
  /// Derived from `month` on write — stored so ordering and exports need no arithmetic.
  sequence            Int
  /// "January 2026", "May intake 2026". Derived from the month and year on write, never typed:
  /// free text let "May Intake", "MAY 2026" and "May intake (late)" accumulate for one cohort.
  name                String
  /// Day one. Every later period of a student who joined here counts from this date.
  startsAt            DateTime
  /// The last day the period runs.
  endsAt              DateTime
  /// The last day to apply. Must be on or before `startsAt`: an applicant cannot be offered a
  /// cohort that has already begun.
  applicationDeadline DateTime
  status              AcademicPeriodStatus @default(PLANNED)

  enrollments    Enrollment[]
  classes        AcademicClass[]
  calendarEvents CalendarEvent[]
  exams          Exam[]
  timetableSlots TimetableSlot[]
  feeItems       FeeItem[]
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([startsAt])
  @@map("academic_periods")
}

/// Admission runs every month here, so each month of a campus year carries the day its
/// admitted students report. An application picks one; a term window is not involved.
model ReportingDate {
  id        String   @id @default(uuid())
  campusId  Int
  campus    Campus   @relation(fields: [campusId], references: [id])
  /// Calendar year the month belongs to.
  year      Int
  /// 1 = January through 12 = December.
  month     Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, year, month])
  @@index([campusId, date])
  @@map("reporting_dates")
}

/// One dated entry on the academic calendar. campusId null means college-wide.
model CalendarEvent {
  id          String            @id @default(uuid())
  /// Nullable so a super admin can post a college-wide entry that belongs to no campus term.
  periodId    String?
  period      AcademicPeriod?   @relation(fields: [periodId], references: [id])
  campusId    Int?
  campus      Campus?           @relation(fields: [campusId], references: [id])
  title       String
  description String?
  type        CalendarEventType
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime          @default(now())

  @@index([startsAt])
  @@index([campusId])
  @@map("calendar_events")
}

model ParentGuardian {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String?
  altPhone     String?
  email        String?
  address      String?
  occupation   String?
  createdAt    DateTime       @default(now())

  @@index([studentId])
  @@map("parent_guardians")
}

model EmergencyContact {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String
  altPhone     String?
  address      String?
  createdAt    DateTime       @default(now())

  @@index([studentId])
  @@map("emergency_contacts")
}

model Enrollment {
  id          String              @id @default(uuid())
  studentId   String
  student     StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId   String
  program     Program             @relation(fields: [programId], references: [id])
  campusId    Int
  campus      Campus              @relation(fields: [campusId], references: [id])
  /// The cohort this student joined through. Required: every student follows an intake's
  /// progression, so there is no such thing as an enrolment without one.
  /// The period this student joined. Their academic life counts forward from here.
  periodId    String
  period      AcademicPeriod      @relation(fields: [periodId], references: [id])
  cohort      String?
  /// Where this student is in THEIR programme, counted from their intake's start — not the
  /// campus calendar semester. A May joiner begins here at 1/1 whatever the campus is doing.
  yearIndex   Int                 @default(1)
  semesterNo  Int                 @default(1)
  /// Moved on by a deliberate promotion, so the office can see when a cohort was advanced.
  promotedAt  DateTime?
  status      EnrollmentStatus    @default(ACTIVE)
  enrolledAt  DateTime            @default(now())
  withdrawnAt DateTime?
  grades      Grade[]
  /// The fee schedule generated for this enrolment, one invoice per payable period.
  invoices    Invoice[]
  /// The student's standing on each unit of the programme.
  units       StudentUnit[]
  /// Their current class, and every class they have belonged to before it.
  memberships ClassMembership[]
  attachments StudentAttachment[]

  @@unique([studentId, programId])
  @@index([campusId, status])
  @@index([periodId, yearIndex, semesterNo])
  @@map("enrollments")
}

/// A recurring weekly class. Times are "HH:mm" strings validated in the action layer.
model TimetableSlot {
  id              String          @id @default(uuid())
  campusId        Int
  campus          Campus          @relation(fields: [campusId], references: [id])
  programId       String
  program         Program         @relation(fields: [programId], references: [id])
  tutorId         String?
  tutor           TutorProfile?   @relation(fields: [tutorId], references: [id])
  periodId        String?
  period          AcademicPeriod? @relation(fields: [periodId], references: [id])
  day             Weekday
  startAt         String
  endAt           String
  room            String?
  weekOffsetLabel String?
  createdAt       DateTime        @default(now())

  @@index([campusId, day])
  @@map("timetable_slots")
}

model Exam {
  id              String          @id @default(uuid())
  title           String
  programId       String
  program         Program         @relation(fields: [programId], references: [id])
  campusId        Int
  campus          Campus          @relation(fields: [campusId], references: [id])
  periodId        String?
  period          AcademicPeriod? @relation(fields: [periodId], references: [id])
  invigilatorId   String?
  invigilator     TutorProfile?   @relation("ExamInvigilator", fields: [invigilatorId], references: [id])
  date            DateTime
  startAt         String
  durationMinutes Int             @default(120)
  room            String?
  /// One sitting. A term normally carries a single CAT and a single end-of-term paper,
  /// but nothing stops it running two CATs or two end-of-term papers.
  type            ExamType        @default(CAT)
  status          ExamStatus      @default(DRAFT)
  grades          Grade[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([campusId, date])
  @@map("exams")
}

/// A mark for one enrollment in one exam; maxScore carries the denominator.
model Grade {
  id           String     @id @default(uuid())
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score        Decimal?   @db.Decimal(6, 2)
  maxScore     Decimal    @default(100) @db.Decimal(6, 2)
  remark       String?
  published    Boolean    @default(false)

  @@unique([examId, enrollmentId])
  @@map("grades")
}

/// A unit of study that can be taught in more than one programme. The definition is shared;
/// where it sits in a programme is a separate row, so a unit is never copied to be reused.
model Unit {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  description  String?
  programUnits ProgramUnit[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("units")
}

/// One unit placed in one period of a programme: "Semester 1 of year 1", "month 3", or a
/// module. `periodKey` is the machine-readable identity of that period, which is what keeps
/// the same unit reusable in two periods without duplicating the unit itself.
model ProgramUnit {
  id           String         @id @default(uuid())
  programId    String
  program      Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  moduleId     String?
  module       ProgramModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// "Y1S2", "M3", "MOD:<id>" or a slug for a custom structure.
  periodKey    String
  periodLabel  String
  yearIndex    Int?
  semesterNo   Int?
  monthIndex   Int?
  /// Reading order inside its period.
  sequence     Int            @default(0)
  isCore       Boolean        @default(true)
  studentUnits StudentUnit[]
  createdAt    DateTime       @default(now())

  @@unique([programId, unitId, periodKey])
  @@index([programId, periodKey])
  @@map("program_units")
}

/// A module of a module-based programme. Its units are ProgramUnit rows that point here.
model ProgramModule {
  id             String        @id @default(uuid())
  programId      String
  program        Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  durationMonths Int?
  sequence       Int           @default(0)
  assessmentNote String?
  isActive       Boolean       @default(true)
  units          ProgramUnit[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([programId, code])
  @@index([programId, sequence])
  @@map("program_modules")
}

/// A student's registration and result for one placed unit. One row per student per unit,
/// created when the student enrols so the whole programme is visible from day one.
model StudentUnit {
  id            String      @id @default(uuid())
  enrollmentId  String
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programUnitId String
  programUnit   ProgramUnit @relation(fields: [programUnitId], references: [id], onDelete: Cascade)
  status        UnitStatus  @default(NOT_STARTED)
  score         Decimal?    @db.Decimal(6, 2)
  maxScore      Decimal?    @db.Decimal(6, 2)
  grade         String?
  remark        String?
  registeredAt  DateTime?
  completedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([enrollmentId, programUnitId])
  @@index([enrollmentId, status])
  @@map("student_units")
}

/// Where an industrial attachment falls in a programme: after a given semester or month, or
/// after every academic period. Several requirements can be configured for one programme.
model AttachmentRequirement {
  id                 String              @id @default(uuid())
  programId          String
  program            Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  sequence           Int                 @default(1)
  label              String
  afterYearIndex     Int?
  afterSemesterNo    Int?
  afterMonthIndex    Int?
  afterAllPeriods    Boolean             @default(false)
  durationWeeks      Int?
  durationMonths     Int?
  startsAt           DateTime?
  endsAt             DateTime?
  prerequisiteNote   String?
  assessmentNote     String?
  isActive           Boolean             @default(true)
  studentAttachments StudentAttachment[]
  createdAt          DateTime            @default(now())

  @@unique([programId, sequence])
  @@index([programId])
  @@map("attachment_requirements")
}

/// One student's placement against one requirement.
model StudentAttachment {
  id               String                @id @default(uuid())
  studentId        String
  student          StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId     String
  enrollment       Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      AttachmentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status           AttachmentStatus      @default(NOT_ELIGIBLE)
  hostOrganization String?
  supervisorName   String?
  supervisorPhone  String?
  supervisorEmail  String?
  startDate        DateTime?
  expectedEndDate  DateTime?
  completedAt      DateTime?
  assessmentNote   String?
  grade            String?
  remark           String?
  updatedAt        DateTime              @updatedAt

  @@unique([enrollmentId, requirementId])
  @@index([studentId, status])
  @@map("student_attachments")
}

/// One published version of a programme's fee structure. Amounts live in the period rows
/// below; a plan is never edited in place, because students already enrolled hold invoices
/// copied from it. Saving a change writes version n+1 and retires version n.
model ProgramFeePlan {
  id             String     @id @default(uuid())
  programId      String
  program        Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  version        Int
  cadenceId      String
  cadence        FeeCadence @relation(fields: [cadenceId], references: [id])
  /// Copied from the programme when the version is published, so the period list stays
  /// readable even if the programme's duration is later corrected.
  durationMonths Int
  totalAmount    Decimal    @db.Decimal(12, 2)
  note           String?
  /// Exactly one plan per programme is active; the partial unique index in the migration
  /// enforces that, which a plain unique constraint cannot do.
  isActive       Boolean    @default(true)
  periods        FeeItem[]
  invoices       Invoice[]
  createdAt      DateTime   @default(now())

  @@unique([programId, version])
  @@index([programId, isActive])
  @@map("program_fee_plans")
}

/// A billable component of a programme's fees. Under a fee plan each row is one payable
/// period (a month, a semester, a year) in the order the student meets it. `semesterId` is
/// only set on legacy per-term components, which are not part of a plan.
model FeeItem {
  id            String          @id @default(uuid())
  programId     String
  program       Program         @relation(fields: [programId], references: [id])
  planId        String?
  plan          ProgramFeePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  periodId      String?
  period        AcademicPeriod? @relation(fields: [periodId], references: [id])
  label         String
  amount        Decimal         @db.Decimal(12, 2)
  isOptional    Boolean         @default(false)
  /// Position in the plan, 1-based. Null on legacy rows that predate plans.
  sequence      Int?
  /// Which year of the programme the period sits in (1 = first year), for calendar linking.
  yearIndex     Int?
  /// Which semester or term of that year, numbered from the institution's own calendar.
  semesterNo    Int?
  /// Days after the student's start that this period falls due. The calendar link overrides
  /// it when the campus has a real semester for this period.
  dueOffsetDays Int?
  invoices      Invoice[]       @relation("FeePeriodInvoices")
  createdAt     DateTime        @default(now())

  @@unique([planId, sequence])
  @@index([programId])
  @@index([planId])
  @@map("fee_items")
}

model Invoice {
  id               String          @id @default(uuid())
  number           String          @unique
  studentId        String
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  campusId         Int
  campus           Campus          @relation(fields: [campusId], references: [id])
  periodId         String?
  period           AcademicPeriod? @relation(fields: [periodId], references: [id])
  programId        String?
  /// Set on a bill generated from a programme's fee plan. Null on a manually raised bill.
  enrollmentId     String?
  enrollment       Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  feePlanId        String?
  feePlan          ProgramFeePlan? @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  feePeriodId      String?
  feePeriod        FeeItem?        @relation("FeePeriodInvoices", fields: [feePeriodId], references: [id], onDelete: Restrict)
  /// Which academic year and semester of the student's programme this period belongs to.
  periodYear       Int?
  periodSemester   Int?
  dueAt            DateTime?
  status           InvoiceStatus   @default(OPEN)
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  voidedFromStatus InvoiceStatus?
  note             String?
  lines            InvoiceLine[]
  payments         Payment[]
  receipts         Receipt[]       @relation("ReceiptSourceInvoice")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  /// Retrying the same enrolment can never bill a period twice.
  @@unique([enrollmentId, feePeriodId])
  @@index([studentId])
  @@index([campusId, status])
  @@index([feePlanId])
  @@map("invoices")
}

model InvoiceLine {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  label          String
  amount         Decimal         @db.Decimal(12, 2)
  kind           InvoiceLineKind @default(CHARGE)
  reference      String?
  idempotencyKey String?         @unique
  reason         String?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime        @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Receipt {
  id                          String         @id @default(uuid())
  number                      String         @unique
  numberNormalized            String         @unique
  kind                        ReceiptKind    @default(RECEIPT)
  studentId                   String
  student                     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  campusId                    Int
  campus                      Campus         @relation(fields: [campusId], references: [id])
  amount                      Decimal        @db.Decimal(18, 2)
  method                      PaymentMethod?
  reference                   String?
  providerReferenceNormalized String?        @unique
  paidAt                      DateTime
  status                      ReceiptStatus  @default(ISSUED)
  idempotencyKey              String?        @unique
  requestHash                 String?
  legacyPaymentId             String?        @unique
  createdById                 String?
  createdByEmail              String?
  reversedAt                  DateTime?
  refundedAt                  DateTime?
  reason                      String?
  sourceInvoiceId             String?
  sourceInvoice               Invoice?       @relation("ReceiptSourceInvoice", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  allocationSnapshot          Json?
  totalFees                   Decimal        @db.Decimal(18, 2)
  paidToDate                  Decimal        @db.Decimal(18, 2)
  balance                     Decimal        @db.Decimal(18, 2)
  createdAt                   DateTime       @default(now())
  payments                    Payment[]

  @@index([studentId, paidAt])
  @@index([campusId, paidAt])
  @@map("receipts")
}

model Payment {
  id                String           @id @default(uuid())
  receiptId         String
  receipt           Receipt          @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  studentId         String
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount            Decimal          @db.Decimal(12, 2)
  method            PaymentMethod
  reference         String?
  /// Denormalized for legacy document routes; Receipt.number is the unique identity.
  receiptNo         String
  entryType         PaymentEntryType @default(PAYMENT)
  reversesPaymentId String?
  reversesPayment   Payment?         @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy        Payment[]        @relation("PaymentReversal")
  reason            String?
  createdById       String?
  createdByEmail    String?
  paidAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([invoiceId])
  @@index([studentId])
  @@index([receiptId])
  @@index([receiptNo])
  @@map("payments")
}

/// Notice-board post for the campus or the whole college (campusId null).
model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  audience    Audience @default(EVERYONE)
  campusId    Int?
  campus      Campus?  @relation(fields: [campusId], references: [id])
  authorId    String?
  author      User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())

  @@index([campusId, publishedAt])
  @@map("announcements")
}

model IdCard {
  id          String         @id @default(uuid())
  serial      String         @unique
  /// The unguessable half of the verification link the card's QR encodes. The serial is
  /// issued in sequence, so it can never be the thing a stranger is given.
  verifyToken String         @unique
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campusId    Int
  campus      Campus         @relation(fields: [campusId], references: [id])
  programId   String?
  program     Program?       @relation(fields: [programId], references: [id])
  templateId  String?
  template    CardTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      CardStatus     @default(PENDING)
  issuedAt    DateTime?
  expiresAt   DateTime?
  remarks     String?
  createdAt   DateTime       @default(now())

  @@index([campusId, status])
  /**
   * The newest live card per student is read on the students list (one lateral per row),
   * when a run looks up existing cards, and when a replacement retires the old ones. The
   * table only ever grows — one row per card ever issued — so the per-student lookup stays
   * an index scan instead of becoming a scan of every card the college has printed.
   */
  @@index([studentId, createdAt(sort: Desc)])
  @@map("id_cards")
}

/// A printable card design, held as text rather than as a file: the artwork is versioned
/// data, not code, so a campus can change its card without a deploy. It is only ever
/// rendered inside this app, which is why it does not live in public object storage.
model CardTemplate {
  id           String   @id @default(uuid())
  name         String
  /// Null means the template is the college-wide fallback.
  campusId     Int?
  campus       Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  frontSvg     String
  backSvg      String
  logoUrl      String   @default("/card-logo.png")
  signatureUrl String   @default("/card-signature.png")
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  idCards      IdCard[]

  /// Deliberately not a unique index: a college-wide template has campusId null, and
  /// Postgres counts nulls as distinct, so a unique constraint would not stop two
  /// competing defaults from being inserted. Which template applies is resolved on read.
  @@index([campusId, name, version])
  @@index([campusId, isActive])
  @@map("card_templates")
}

/// A teaching group: the students one office sits together for scheduling, marks and
/// reporting. A class is a GROUPING, never an academic position — two students in the same
/// class can be in different semesters, and moving a student between classes leaves their
/// placement, units, results and fees untouched.
///
/// Intake is an official window (January, May or September), so admissions spread across
/// other months all land in one of these three classes. Offices may still keep a temporary
/// class such as ICT/JAN-FEB/2027 and merge it into the regular one later.
model AcademicClass {
  id          String            @id @default(uuid())
  campusId    Int
  campus      Campus            @relation(fields: [campusId], references: [id])
  programId   String
  program     Program           @relation(fields: [programId], references: [id])
  periodId    String
  period      AcademicPeriod    @relation(fields: [periodId], references: [id])
  /// The academic year the class is taught in, e.g. 2027.
  year        Int
  /// What the office calls it, e.g. "ICT/JAN/2027" or "ICT/JAN-FEB/2027". Free text: names
  /// are the office's own convention, not something the system dictates.
  name        String
  /// Optional human note explaining a temporary class, e.g. "Late January joiners".
  note        String?
  status      ClassStatus       @default(ACTIVE)
  archivedAt  DateTime?
  ambient     String?           @default("purple")
  memberships ClassMembership[]
  /// The tutors who teach this class. They run its group chat and can post when the room is
  /// set to staff-only; students see the room but cannot rename or remove anyone.
  tutors      ClassTutor[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  conversation Conversation?

  /// A name identifies a class within one campus, programme and intake. Scoping it to the
  /// programme alone blocked the same name in a different intake, and let an intake's class be
  /// found under a name that belonged to another.
  @@unique([campusId, programId, periodId, name])
  @@index([campusId, year, status])
  @@index([periodId])
  @@index([programId, periodId, year])
  @@map("academic_classes")
}

/// A student's time in a class. Rows are never deleted or overwritten: a class change closes
/// the open row and opens a new one, so the full history is available for audit and for
/// reporting on a class as it stood on any date.
model ClassMembership {
  id           String        @id @default(uuid())
  classId      String
  class        AcademicClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  campusId     Int
  joinedAt     DateTime      @default(now())
  /// Set when the student leaves this class; the row stays as history either way.
  leftAt       DateTime?
  /// Why they moved, for the audit trail: admitted, moved, merged, archived.
  reason       String?
  /// The administrator who made the change.
  actorId      String?
  createdAt    DateTime      @default(now())

  @@index([enrollmentId, leftAt])
  @@index([classId, leftAt])
  @@map("class_memberships")
}

/// A decision about study a student completed elsewhere. Recording the request and the
/// decision separately keeps the evidence (documents, grades) even when the answer is no.

/// One row per important change. Rows are append-only: nothing here is edited or deleted.
model AuditLog {
  id         String   @id @default(uuid())
  campusId   Int?
  actorId    String?
  actorEmail String?
  /// Dotted action name, e.g. "class.merge", "enrollment.place".
  action     String
  entityType String
  entityId   String
  /// JSON text: what changed. Never contains passwords or card details.
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([campusId, createdAt])
  @@map("audit_logs")
}

/// One print run. Kept so a batch can be reopened, re-downloaded or reprinted without
/// generating the cards again — the office prints a class, then a late joiner arrives, then
/// the first batch is asked for again weeks later.
model CardBatch {
  id          String          @id @default(uuid())
  campusId    Int?
  campus      Campus?         @relation(fields: [campusId], references: [id])
  /// What the run covered, for the history line: "Class KNEC-D/JAN/2026".
  targetLabel String
  cardCount   Int
  sheetCount  Int
  /// Where the generated PDF lives. The file itself is in object storage, not the database.
  fileUrl     String?
  /// Where the run stands. COMPLETE is the default so every run recorded before the
  /// queue existed reads exactly as it always did: done.
  status      CardBatchStatus @default(COMPLETE)
  /// Fingerprint of the REQUEST: campus, target and the students it covered. A double
  /// submit — or two officers printing the same class together — resolves to the run that
  /// is already queued instead of queueing a second identical render.
  actionHash  String?
  /// Fingerprint of the RENDERED content. A re-run whose cards are unchanged reuses the
  /// PDF already in object storage: no second render, and no second copy of the file.
  contentHash String?
  actorId     String?
  actorEmail  String?
  createdAt   DateTime        @default(now())

  @@index([campusId, createdAt])
  /// Both lookups are "the newest run with this fingerprint", so the index carries the
  /// sort column too rather than filtering a campus's whole history.
  @@index([actionHash, createdAt])
  @@index([contentHash, createdAt])
  @@map("card_batches")
}

/**
 * ───────────────────────── Chat ─────────────────────────
 */

/// DIRECT, CLASS or GROUP. A broadcast is not its own kind of conversation: it lands in a
/// DIRECT thread with the sender, so the recipient can simply reply.
enum ConversationType {
  DIRECT
  CLASS
  GROUP
}

/// CLASS rooms default to open posting. STAFF_ONLY is for a class whose tutors want an
/// announcements-only room, and is the same flag that stops a student posting to it.
enum PostingMode {
  ALL_MEMBERS
  STAFF_ONLY
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

/// One thread. `directKey` is the ordered pair of user ids, so the database itself refuses a
/// second thread between the same two people no matter how many tabs ask for one.
model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  title         String?
  /// Set for CLASS rooms only; unique so a class can never have two rooms.
  classId       String?          @unique
  academicClass AcademicClass?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  directKey     String?          @unique
  postingMode   PostingMode      @default(ALL_MEMBERS)
  createdById   String?
  createdAt     DateTime         @default(now())
  /// Denormalised for ordering the chat list without a join over every message.
  lastMessageAt DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([type, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// A person's place in a thread. Left (or withdrawn) members keep the row so their read
/// position and mute state survive a rejoin, and lose access through `leftAt`.
model ConversationMember {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              MemberRole   @default(MEMBER)
  joinedAt          DateTime     @default(now())
  /// The newest message this member has read. Nullable because a new member has read nothing.
  lastReadMessageId String?
  /// A muted thread produces no pop-up until this moment passes.
  mutedUntil        DateTime?
  leftAt            DateTime?

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body            String
  /// The client's own id for optimistic sending: makes a retry after a flaky network land
  /// once, not twice.
  clientMessageId String?
  replyToId       String?
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReply")
  createdAt       DateTime     @default(now())
  editedAt        DateTime?
  /// Soft delete. The row stays so reports and the audit trail still resolve.
  deletedAt       DateTime?

  receipts       MessageReceipt[]
  messageReports MessageReport[]
  attachments    ChatAttachment[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Read and delivery are per person, so a group's double ticks mean "everyone has read it".
model MessageReceipt {
  id          String    @id @default(uuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_receipts")
}

/// A block is one-directional: the blocker stops the blocked person messaging or finding them.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockIssuer", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id         String       @id @default(uuid())
  messageId  String
  message    Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@map("message_reports")
}

/// An admin's decision that someone may not post for a while.
model ChatRestriction {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  restrictedUntil DateTime?
  reason          String
  byAdminId       String?
  createdAt       DateTime  @default(now())

  @@index([userId, restrictedUntil])
  @@map("chat_restrictions")
}

/// A file shared in a message.
///
/// Files are private: the bucket URL is never handed to a browser, and downloads go through an
/// authenticated route that re-checks conversation membership. A public object URL would outlive
/// every deletion we make, which would make the seven-day rule a fiction.
model ChatAttachment {
  id          String    @id @default(uuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// The object key in the bucket. Never the URL: the key is what deletion needs.
  storageKey  String
  /// What the recipient called it, shown in the bubble. Not a path and never trusted blindly.
  fileName    String
  contentType String
  sizeBytes   Int
  /// When the object, the row and the message all disappear. Seven days after upload.
  expiresAt   DateTime
  /// Set once the cleanup job has removed the object, so a stuck row is visible rather than silently leaking.
  deletedAt   DateTime?

  @@index([expiresAt])
  @@index([messageId])
  @@map("chat_attachments")
}

/// A tutor assigned to a class.
///
/// This is the only definition of "responsible for the class", and therefore the only thing that
/// decides who belongs in the class group chat. Keeping it a table of its own means a tutor can
/// be moved between classes without touching the conversation's members by hand.
model ClassTutor {
  id         String        @id @default(uuid())
  classId    String
  class      AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutorId    String
  tutor      TutorProfile  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  /// True for the tutor who owns the class day to day.
  isLead     Boolean       @default(false)
  assignedAt DateTime      @default(now())
  actorId    String?

  @@unique([classId, tutorId])
  @@index([tutorId])
  @@map("class_tutors")
}

/// One admission letter the college has issued.
///
/// A row is what makes a letter trustworthy: it records the exact snapshot that was printed, the
/// reference the applicant quotes, the deadline to accept, and who issued it. Letters are
/// regenerated from this snapshot rather than stored, so reprinting a year later still shows the
/// terms the applicant was actually offered — not today's fees.
model OfferLetter {
  id                     String      @id @default(uuid())
  /// The number printed on the letter and quoted by the applicant: EAVI/OL/2026/00042.
  reference              String      @unique
  /// The unguessable half of the public verification link behind the letter's QR.
  verifyToken            String      @unique
  /// Separate, expiring bearer capability for the private PDF download.
  downloadTokenHash      String?
  downloadTokenExpiresAt DateTime?
  applicationId          String
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programId              String
  campusId               Int
  /// The applicant's name as printed, frozen so a later correction does not rewrite history.
  printedName            String
  /// The fee structure and bursary PDFs in force when the letter was issued.
  feeStructureUrl        String?
  bursaryFormUrl         String?
  /// The requirements text as printed on page 3.
  requirements           String?
  /// How long the applicant has to accept. Printed on the letter and enforced by nothing but
  /// the office, because admissions run monthly and a late acceptance is a decision.
  expiresAt              DateTime
  issuedAt               DateTime    @default(now())
  issuedById             String?
  issuedByEmail          String?
  /// Set when the office withdraws a letter it should not have sent.
  revokedAt              DateTime?
  revokeReason           String?
  campus                 Campus      @relation(fields: [campusId], references: [id])
  program                Program     @relation(fields: [programId], references: [id])

  @@unique([applicationId])
  @@index([campusId, issuedAt])
  @@map("offer_letters")
}

/// One browser (or installed PWA) registered to receive web push for one person.
/// A user may hold several: a phone and a laptop are both theirs. The endpoint is the
/// browser-minted address pushes are delivered to, unique so a re-subscription updates
/// the same row instead of piling up duplicates.
model PushSubscription {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  /// What was running when the subscription was created, so "Sign in on this device"
  /// can name the phone or the laptop rather than a bare URL.
  deviceName String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// The last time a push to this endpoint was accepted, or it was first registered.
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// One notification for one person. Delivered by web push to their devices and shown
/// in the portal's bell, both reading the same row.
model Notification {
  id               String   @id @default(uuid())
  recipient        User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientUserId  String
  title            String
  body             String
  /// What kind of event it came from — announcement, fee, result, message — so
  /// preferences can mute a kind and the bell can group them.
  notificationType String
  /// Where the notification opens when clicked. Null opens the portal home.
  targetUrl        String?
  /// Extra context a screen may use; deliberately small — nothing that must not
  /// survive on a lock screen belongs in here.
  data             Json?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
  /// One notification per person per event: the sender names the event, and the unique
  /// index is what keeps a retried action from telling someone the same thing twice.
  dedupeKey        String?

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, isRead])
  @@map("notifications")
}

/// What a person does not want to hear about. Stored per person, not per device:
/// muting a kind mutes it everywhere, while turning notifications off on one device is
/// the browser's own permission, held by that device alone.
model NotificationPreference {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @id
  mutedTypes String[] @default([])
  updatedAt  DateTime @updatedAt

  @@map("notification_preferences")
}

/// A saved document: the data snapshot, its rendered SVG/PDF and the hash of the source.
/// One row per document (kind + scope), so a document is loaded, never rebuilt on view.
/// A source change only marks it STALE; a worker re-renders it in the background.
model GeneratedDocument {
  id         String   @id @default(uuid())
  kind       String
  scopeKey   String
  version    Int      @default(1)
  sourceHash String
  snapshot   Json
  svgText    String
  storageUrl String?
  fileName   String
  status     String   @default("CURRENT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, scopeKey])
  @@index([status])
  @@map("generated_documents")
}
