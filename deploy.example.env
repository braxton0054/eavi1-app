# Copy to .env on the server, then fill in real values. Never commit the copy.
# docker compose reads this file automatically.

POSTGRES_DB=eavi
POSTGRES_USER=eavi_app
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The port the portal listens on behind your reverse proxy.
APP_PORT=3000

# Where the release image lives; matches the tag pushed by the Release workflow.
APP_IMAGE=ghcr.io/braxton0054/eavi1-app:latest

# Object storage (Contabo S3-compatible). Without these the portal runs, but
# every file upload fails with "File storage is not configured".
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Contabo public object URLs include the account id prefix.
S3_ACCOUNT_ID=

# Web push (VAPID) for browser notifications. Generate a pair with:
#   npx web-push generate-vapid-keys
# The private key must never leave the server. Reuse the same pair across every
# deployment, or previously subscribed devices would need to re-subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@eavi.ac.ke
# Same value as VAPID_PUBLIC_KEY (it is inlined into the client bundle).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# "Sign in with Google" (free — OAuth client credentials need no billing account).
# See docs/GOOGLE-OAUTH.md for the Cloud Console steps. Leave empty to disable the
# button; the password form is unaffected either way. The secret is server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in the console, byte for byte. HTTPS in production.
GOOGLE_REDIRECT_URI=https://eavi.college.eavi.shop/api/auth/google/callback


# College email service (Gmail SMTP). Create an App Password at
# myaccount.google.com/apppasswords (2-step verification required) — never the
# account password. MAIL_SECURE=false on port 587 means STARTTLS.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME="College Management System"
MAIL_FROM_ADDRESS=
